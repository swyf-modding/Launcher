<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The switchboard, built with the SDK rather than by hand-rolled csc.

    Avalonia on net10.0, deliberately. The previous build was WPF on .NET Framework 4.8, which shipped
    with every Windows 10 and 11 and so needed nothing installed on the player's machine - but it was
    Windows-only by construction, and .NET Framework has no Linux. Avalonia draws the same UI on Windows,
    Linux and macOS from one codebase, and .NET 10 is self-contained when published, so the download is
    still a single file a player can just run.

    The setup logic is not reimplemented here. ScamWYF.Setup.Core does the work in-process, so the
    switchboard, the CLI and the tests all run the same code; this project only presents it.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Switchboard</AssemblyName>
    <RootNamespace>Switchboard</RootNamespace>

    <!--
      The switchboard's own icon: the gold S-switch on its wooden tile. The .ico is the
      executable's icon as Explorer and the taskbar show it; the png beside it is the
      WindowIcon every window is given, because Avalonia decodes png on every platform.
      Same drawing as the site's favicon.
    -->
    <ApplicationIcon>src/assets/switchboard.ico</ApplicationIcon>

    <!-- Bindings are the reflection kind, not compiled: the row types are internal and the views bind
         to plain properties. Compiled bindings would need an x:DataType on every template. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Off, and it matters. By default the SDK appends "+<full commit sha>" to
      AssemblyInformationalVersion, on top of whatever was passed in. Since build.sh/build.ps1 already
      derives the version from `git describe` - which includes the short sha, the commit count and the
      dirty marker - the two combined into "1.3.0+g2872ebc.dirty.2872ebc33cf...", which is both wrong
      and different on every machine that checks out the same commit. The tag-derived string is the one
      that is correct, so the SDK must not add to it.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!--
      AVLN3001: "XAML resource ... won't be reachable via runtime loader, as no public constructor was
      found". Both windows are constructed in code, not by the runtime loader: MainWindow takes the
      command-line arguments and ConfigWindow takes the config it edits, so neither has a parameterless
      constructor to load by avares:// URI - and nothing here ever does that. The warning is about a path
      this app does not use, so it is turned off rather than worked around with a constructor nobody calls.
    -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- No pdb in Release: the download is the exe alone now, so there is nothing to keep it for. -->
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <!-- The setup logic, in-process. Its types are used directly: GameInstall, SetupRunner, the
         payload, ProtonIntegration. Nothing here drives PowerShell any more. -->
    <ProjectReference Include="../Setup/src/ScamWYF.Setup.Core/ScamWYF.Setup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia's default glob is *.axaml, and this project's markup is *.xaml. Without this the
         markup is not compiled and the build fails at run time with an unhelpful XAML error, or the
         views simply never render. -->
    <AvaloniaXaml Include="src/**/*.xaml" />
    <None Remove="src/**/*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two faces the site uses, bundled so the app looks the same on a machine with
         neither installed. Nunito Sans carries the body text; Bowlby One is the display
         face the site uses for headings and buttons. Both are SIL Open Font Licence, and
         the licence text sits beside the files. -->
    <AvaloniaResource Include="src/fonts/**/*.ttf">
      <!-- The avares path is the resource's link, not its path on disk, so the faces sit at
           avares://Switchboard/fonts/body and .../display however the sources are laid out. -->
      <Link>fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AvaloniaResource>
    <None Remove="src/fonts/**/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon. Linked to a fixed avares path, so the markup names the same thing
         however the source tree is laid out. -->
    <AvaloniaResource Include="src/assets/switchboard.png">
      <Link>assets/switchboard.png</Link>
    </AvaloniaResource>
    <None Remove="src/assets/switchboard.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests are their own project. Without this the default glob would pull tests\*.cs into the
         application, where it would collide on a second Main. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <AvaloniaXaml Remove="tests/**" />
  </ItemGroup>

</Project>

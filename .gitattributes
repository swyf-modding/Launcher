# Line endings. This is a Windows-only WinForms app, built from sources directly, so CRLF in the
# working tree and LF in the repository. Pinned here rather than left to each developer's
# core.autocrlf so a build does not depend on who checked it out.
* text=auto eol=crlf

*.cs    text eol=crlf
*.csproj text eol=crlf
*.ps1   text eol=crlf
*.md    text eol=crlf
*.resx  text eol=crlf
*.config text eol=crlf

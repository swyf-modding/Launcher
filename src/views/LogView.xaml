<UserControl x:Class="ScamWYF.Launcher.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Padding="16">

    <!--
        The log tab: what the game and the loader said last time it ran.

        The first thing anyone does with a broken mod is open LogOutput.log, and it lives in the game
        folder where a player will not think to look. Showing it here, and following it while the game
        runs, turns the usual copy-paste-into-a-chat-box into one click.

        Errors are picked out and listed above the raw text. A BepInEx log is thousands of lines of
        which the useful part is three, and scrolling for them is the whole problem.
    -->
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline" Grid.Row="0" Style="{StaticResource HeadingText}" />

        <!-- This list is the one that used to show a horizontal scrollbar with nothing to scroll to,
             because its columns were fixed pixel widths inside a panel that had not been given its real
             width yet. The last column is a star column now, so there is nothing to scroll to. -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" SharedSizeGroup="Line" />
                    <ColumnDefinition Width="200" SharedSizeGroup="What" />
                    <ColumnDefinition Width="*" SharedSizeGroup="Detail" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Line" Style="{StaticResource ColumnHeaderText}" />
                <TextBlock Grid.Column="1" Text="What" Style="{StaticResource ColumnHeaderText}" />
                <TextBlock Grid.Column="2" Text="Detail" Style="{StaticResource ColumnHeaderText}" />
            </Grid>

            <Border Grid.Row="0" Style="{StaticResource ColumnHeaderRule}" VerticalAlignment="Bottom" />

            <ListView x:Name="Problems" Grid.Row="1">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Foreground" Value="{Binding Brush}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" SharedSizeGroup="Line" />
                                <ColumnDefinition Width="200" SharedSizeGroup="What" />
                                <ColumnDefinition Width="*" SharedSizeGroup="Detail" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Line}" Style="{StaticResource CellText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource CellText}" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource CellText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Reload" Style="{StaticResource FlatButton}" Click="OnReload" />
            <Button Content="Open log in notepad" Margin="8,0,0,0" Style="{StaticResource FlatButton}" Click="OnOpenLog" />
            <Button Content="Open game folder" Margin="8,0,0,0" Style="{StaticResource FlatButton}" Click="OnOpenGame" />
            <CheckBox x:Name="Follow" Margin="24,0,0,0" VerticalAlignment="Center"
                      IsChecked="True" Content="Follow while the game runs" />
        </StackPanel>

        <TextBox x:Name="Raw" Grid.Row="3"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                 VerticalContentAlignment="Top"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="4" Style="{StaticResource NoteText}"
                   Text="BepInEx writes this on every launch. A preloader crash, before BepInEx starts, goes to preloader_*.log in the game folder instead." />
    </Grid>
</UserControl>
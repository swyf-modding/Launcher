<UserControl x:Class="Switchboard.Views.GetModsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Padding="16">

    <!--
        The Get mods tab: fetch a release from GitHub, or install a dll from a URL.

        Separate from the Mods tab on purpose. That one is bookkeeping over files already on disk and
        never touches the network; this one downloads code that will be executed by the game. Keeping them
        apart means the Mods tab's promise - it moves and deletes files, nothing more - stays true, and
        the consequences of installing are somewhere you only arrive deliberately.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" Grid.Row="0" Classes="strong" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mod" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="Release" Classes="columnHeader" />
                <TextBlock Grid.Column="2" Text="Size" Classes="columnHeader" />
                <TextBlock Grid.Column="3" Text="Installed" Classes="columnHeader" />
                <TextBlock Grid.Column="4" Text="What it does" Classes="columnHeader" />
            </Grid>

            <Border Grid.Row="0" Classes="rule" VerticalAlignment="Bottom" />

            <ListBox x:Name="List" Grid.Row="1" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell" />
                            <TextBlock Grid.Column="1" Text="{Binding Tag}" Classes="cell" />
                            <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="cell" />
                            <TextBlock Grid.Column="3" Text="{Binding Installed}" Classes="cell" />
                            <TextBlock Grid.Column="4" Text="{Binding What}" Classes="cell" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="CheckButton" Content="Check for updates" MinWidth="150"
                    Theme="{StaticResource FlatButton}" Click="OnCheck" />
            <Button x:Name="InstallButton" Content="Install..." Margin="8,0,0,0" MinWidth="130"
                    Theme="{StaticResource AccentButton}" Click="OnInstall" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Install a dll from a URL"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />

            <TextBox x:Name="UrlBox" Grid.Column="1" VerticalContentAlignment="Center" />

            <Button x:Name="FromUrlButton" Grid.Column="2" Content="Download and install..." Margin="8,0,0,0"
                    Theme="{StaticResource FlatButton}" Click="OnFromUrl" />
        </Grid>

        <TextBlock Grid.Row="4" Classes="note" Foreground="{StaticResource WarnBrush}"
                   Text="Installing a mod puts code in your game folder that BepInEx will load and run on the next launch. Only install what you trust.&#10;&#10;Mods are downloaded over https and checked against the SHA-256 GitHub publishes for them. That catches a corrupted download; it is not a signature, and it cannot tell you whether a mod is safe to run.&#10;&#10;Changes take effect on the next launch." />
    </Grid>
</UserControl>

<UserControl x:Class="ScamWYF.Launcher.Views.GetModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Padding="16">

    <!--
        The Get mods tab: fetch a release from GitHub, or install a dll from a URL.

        Separate from the Mods tab on purpose. That one is bookkeeping over files already on disk and
        never touches the network; this one downloads code that will be executed by the game. Keeping them
        apart means the Mods tab's promise - it moves and deletes files, nothing more - stays true, and
        the consequences of installing are somewhere you only arrive deliberately.
    -->
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" Grid.Row="0" Style="{StaticResource StrongText}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" SharedSizeGroup="Mod" />
                    <ColumnDefinition Width="90" SharedSizeGroup="Release" />
                    <ColumnDefinition Width="90" SharedSizeGroup="Size" />
                    <ColumnDefinition Width="120" SharedSizeGroup="Installed" />
                    <ColumnDefinition Width="*" SharedSizeGroup="What" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mod" Style="{StaticResource ColumnHeaderText}" />
                <TextBlock Grid.Column="1" Text="Release" Style="{StaticResource ColumnHeaderText}" />
                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource ColumnHeaderText}" />
                <TextBlock Grid.Column="3" Text="Installed" Style="{StaticResource ColumnHeaderText}" />
                <TextBlock Grid.Column="4" Text="What it does" Style="{StaticResource ColumnHeaderText}" />
            </Grid>

            <Border Grid.Row="0" Style="{StaticResource ColumnHeaderRule}" VerticalAlignment="Bottom" />

            <ListView x:Name="List" Grid.Row="1" SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" SharedSizeGroup="Mod" />
                                <ColumnDefinition Width="90" SharedSizeGroup="Release" />
                                <ColumnDefinition Width="90" SharedSizeGroup="Size" />
                                <ColumnDefinition Width="120" SharedSizeGroup="Installed" />
                                <ColumnDefinition Width="*" SharedSizeGroup="What" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Tag}" Style="{StaticResource CellText}" />
                            <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource CellText}" />
                            <TextBlock Grid.Column="3" Text="{Binding Installed}" Style="{StaticResource CellText}" />
                            <TextBlock Grid.Column="4" Text="{Binding What}" Style="{StaticResource CellText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="CheckButton" Content="Check for updates" MinWidth="150"
                    Style="{StaticResource FlatButton}" Click="OnCheck" />
            <Button x:Name="InstallButton" Content="Install…" Margin="8,0,0,0" MinWidth="130"
                    Style="{StaticResource AccentButton}" Click="OnInstall" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Install a dll from a URL"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />

            <TextBox x:Name="UrlBox" Grid.Column="1" VerticalContentAlignment="Center" />

            <Button x:Name="FromUrlButton" Grid.Column="2" Content="Download and install…" Margin="8,0,0,0"
                    Style="{StaticResource FlatButton}" Click="OnFromUrl" />
        </Grid>

        <TextBlock Grid.Row="4" Style="{StaticResource NoteText}" Foreground="{StaticResource WarnBrush}"
                   Text="Installing a mod puts code in your game folder that BepInEx will load and run on the next launch. Only install what you trust.&#10;&#10;Mods are downloaded over https and checked against the SHA-256 GitHub publishes for them. That catches a corrupted download; it is not a signature, and it cannot tell you whether a mod is safe to run.&#10;&#10;Changes take effect on the next launch." />
    </Grid>
</UserControl>
<UserControl x:Class="Switchboard.Views.ModsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Padding="16">

    <!--
        The mods tab: what is installed, and the three things anyone wants to do to it.

        Enable, disable, delete. BepInEx has no enable/disable of its own, so this moves files between
        plugins\ and plugins_disabled\ - the same thing a person would do by hand, which means it is
        unsurprising when it does not work.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" Grid.Row="0" Classes="strong" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mod" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="Version" Classes="columnHeader" />
                <TextBlock Grid.Column="2" Text="State" Classes="columnHeader" />
                <TextBlock Grid.Column="3" Text="GUID" Classes="columnHeader" />
                <TextBlock Grid.Column="4" Text="Note" Classes="columnHeader" />
            </Grid>

            <Border Grid.Row="0" Classes="rule" VerticalAlignment="Bottom" />

            <ListBox x:Name="List" Grid.Row="1"
                     SelectionChanged="OnSelectionChanged"
                     DoubleTapped="OnDoubleClick">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Foreground" Value="{Binding Brush}" />
                        <!-- Named on the container, not on the Grid inside the template, so a screen
                             reader announces the mod's name for the row rather than an unnamed item. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell" />
                            <TextBlock Grid.Column="1" Text="{Binding Version}" Classes="cell" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" Classes="cell" />
                            <TextBlock Grid.Column="3" Text="{Binding Guid}" Classes="cell" />
                            <TextBlock Grid.Column="4" Text="{Binding Note}" Classes="cell" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="EnableButton" Content="Enable" Theme="{StaticResource FlatButton}" Click="OnToggle" />
            <Button x:Name="DisableButton" Content="Disable" Margin="8,0,0,0" Theme="{StaticResource FlatButton}" Click="OnToggle" />
            <Button x:Name="DeleteButton" Content="Delete..." Margin="8,0,0,0" Theme="{StaticResource FlatButton}" Click="OnDelete" />
            <Button x:Name="ConfigButton" Content="Config..." Margin="8,0,0,0" Theme="{StaticResource FlatButton}" Click="OnConfig" />
            <Button Content="Rescan" Margin="8,0,0,0" Theme="{StaticResource FlatButton}" Click="OnRescan" />
            <Button Content="Open plugins folder" Margin="8,0,0,0" Theme="{StaticResource FlatButton}" Click="OnOpenPlugins" />
            <Button Content="Open disabled folder" Margin="8,0,0,0" Theme="{StaticResource FlatButton}" Click="OnOpenDisabled" />
        </StackPanel>

        <TextBlock Grid.Row="3" Classes="note"
                   Text="Enable and disable move the file between plugins and plugins_disabled, which is what BepInEx watches. Changes take effect on the next launch." />
    </Grid>
</UserControl>

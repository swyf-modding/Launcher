<UserControl x:Class="Switchboard.Views.SetupView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Padding="16">

    <!--
        The setup tab: what is missing from the install, and a button to run the setup.

        The status list is generated from probing the install rather than hardcoded, so a new piece of
        setup can be added to the core without this file learning about it. Anything the install needs
        shows a way to get it, because "not ready" without a next step is the least useful thing a setup
        tool can say.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What this tab is for, in one line, under the tab strip. -->
        <TextBlock x:Name="PurposeText" Grid.Row="0" Classes="purpose" Margin="0,0,0,10" />

        <TextBlock x:Name="Headline" Grid.Row="1" Classes="heading" />

        <!-- The columns are declared twice - once for the header, once for the rows. Avalonia has no
             SharedSizeGroup, so the widths are written out in both places; the last column is a star
             column, which is what a real table needs so there is no horizontal scrollbar. -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Check" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="State" Classes="columnHeader" />
                <TextBlock Grid.Column="2" Text="Detail" Classes="columnHeader" />
            </Grid>

            <Border Grid.Row="0" Classes="rule" VerticalAlignment="Bottom" />

            <ListBox x:Name="Checks" Grid.Row="1">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Foreground" Value="{Binding Brush}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="tableRow">
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell" />
                                <TextBlock Grid.Column="1" Text="{Binding State}" Classes="cell" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="cell" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!--
            The one thing this tab is for is on the left, where the eye lands first. The two setup
            buttons are alternatives for the same job - the second runs without downloading, which
            is the one to reach for on a machine with no network - and "Open game folder" is a
            utility rather than a step, so it sits at the far end.
        -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="RunButton" Content="Set up / repair" MinWidth="130"
                        Theme="{StaticResource AccentButton}" Click="OnRun" />
                <Button x:Name="OfflineButton" Content="Set up (offline)" Margin="8,0,0,0"
                        Theme="{StaticResource FlatButton}" Click="OnRunOffline" />
            </StackPanel>

            <Button Grid.Column="2" Content="Open game folder"
                    Theme="{StaticResource FlatButton}" Click="OnOpenFolder" />
        </Grid>

        <!--
            A heading over the output box, so the box is named rather than being a large empty
            rectangle, and the checkbox that drives it sits with it instead of at the far end of
            the window.
        -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Output" Classes="columnHeader" Margin="0" />

            <CheckBox x:Name="FollowLog" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                      Content="Follow the output as it runs" />
        </Grid>

        <!-- Read-only, monospaced, no wrap: this is setup output, so the line breaks are structure. -->
        <TextBox x:Name="Output" Grid.Row="5"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                 Watermark="The setup writes what it does here."
                 VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>

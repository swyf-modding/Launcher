<UserControl x:Class="Switchboard.Views.SetupView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Padding="16">

    <!--
        The setup tab: what is missing from the install, and a button to run the setup.

        The status list is generated from probing the install rather than hardcoded, so a new piece of
        setup can be added to the core without this file learning about it. Anything the install needs
        shows a way to get it, because "not ready" without a next step is the least useful thing a setup
        tool can say.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline" Grid.Row="0" Classes="heading" />

        <!-- The columns are declared twice - once for the header, once for the rows. Avalonia has no
             SharedSizeGroup, so the widths are written out in both places; the last column is a star
             column, which is what a real table needs so there is no horizontal scrollbar. -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Check" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="State" Classes="columnHeader" />
                <TextBlock Grid.Column="2" Text="Detail" Classes="columnHeader" />
            </Grid>

            <Border Grid.Row="0" Classes="rule" VerticalAlignment="Bottom" />

            <ListBox x:Name="Checks" Grid.Row="1">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Foreground" Value="{Binding Brush}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell" />
                            <TextBlock Grid.Column="1" Text="{Binding State}" Classes="cell" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="cell" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="RunButton" Content="Set up / repair" MinWidth="130"
                    Theme="{StaticResource AccentButton}" Click="OnRun" />
            <Button x:Name="OfflineButton" Content="Offline" Margin="8,0,0,0"
                    Theme="{StaticResource FlatButton}" Click="OnRunOffline" />
            <Button Content="Open game folder" Margin="8,0,0,0"
                    Theme="{StaticResource FlatButton}" Click="OnOpenFolder" />
        </StackPanel>

        <!-- Read-only, monospaced, no wrap: this is setup output, so the line breaks are structure. -->
        <TextBox x:Name="Output" Grid.Row="3"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                 VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <CheckBox x:Name="FollowLog" Grid.Row="4" Margin="0,10,0,0" IsChecked="True"
                  Content="Follow the log while it runs" />
    </Grid>
</UserControl>

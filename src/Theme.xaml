<!--
    The launcher's palette and control styles.

    The colours are mod-lib's UiTheme, which the shared library reads from the game's live theme and
    falls back to these. So the launcher and the in-game menu it opens are one visual system rather than
    two, and if the game ever changes its colours there is one file to change instead of a set of
    hard-coded greys scattered across four views.

    Dark and low-chroma on purpose: a tool that sits in front of a game should recede. It is mostly read
    at a glance to answer "is my install fine".

    This is Avalonia, not WPF, and the shape of the file changed with it. FluentTheme supplies every
    control's control theme (see App.xaml), and everything here is layered on top: plain styles win over
    a control theme in Avalonia, so the palette below recolours the stock controls without reimplementing
    text selection, popups or focus adorers. Only the four things Fluent draws in its own colours - the
    buttons, the tab strip, the chips and the list rows - need a template, because setting a property
    does nothing to chrome a control paints itself. That was the whole reason the WPF version replaced
    templates, and it is exactly as true here.

    A ControlTheme is a resource in Avalonia, not a style, so the four of them live in Styles.Resources
    beside the palette rather than as siblings of the Style elements below.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>

        <!-- ======================================================== palette -->

        <Color x:Key="WindowColor">#212126</Color>
        <Color x:Key="SurfaceColor">#2B2B32</Color>
        <Color x:Key="SurfaceShadedColor">#26262C</Color>
        <Color x:Key="FieldColor">#15151A</Color>
        <Color x:Key="TextColor">#E6E6EA</Color>
        <Color x:Key="MutedColor">#9E9EAA</Color>
        <Color x:Key="BorderColor">#3A3A44</Color>
        <Color x:Key="ButtonFaceColor">#383842</Color>
        <Color x:Key="ButtonHoverColor">#4C4C58</Color>
        <Color x:Key="AccentColor">#296BB8</Color>
        <Color x:Key="AccentMutedColor">#243044</Color>
        <Color x:Key="GoodColor">#5FC18A</Color>
        <Color x:Key="WarnColor">#F3C259</Color>
        <Color x:Key="BadColor">#F36B66</Color>

        <SolidColorBrush x:Key="WindowBrush"        Color="{StaticResource WindowColor}" />
        <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceShadedBrush" Color="{StaticResource SurfaceShadedColor}" />
        <SolidColorBrush x:Key="FieldBrush"         Color="{StaticResource FieldColor}" />
        <SolidColorBrush x:Key="TextBrush"          Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedBrush"         Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="ButtonFaceBrush"    Color="{StaticResource ButtonFaceColor}" />
        <SolidColorBrush x:Key="ButtonHoverBrush"   Color="{StaticResource ButtonHoverColor}" />
        <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentMutedBrush"   Color="{StaticResource AccentMutedColor}" />
        <SolidColorBrush x:Key="GoodBrush"          Color="{StaticResource GoodColor}" />
        <SolidColorBrush x:Key="WarnBrush"          Color="{StaticResource WarnColor}" />
        <SolidColorBrush x:Key="BadBrush"           Color="{StaticResource BadColor}" />

        <!-- ======================================================== typography -->

        <!-- Inter travels with the app (Avalonia.Fonts.Inter), so the same face is used where Segoe UI
             does not exist - which is everywhere this runs except Windows. -->
        <FontFamily x:Key="UiFont">Inter, Segoe UI, sans-serif</FontFamily>

        <!-- The raw log and the setting names are monospaced: the line breaks and the punctuation are
             structure, and a proportional face makes both harder to scan. -->
        <FontFamily x:Key="MonoFont">Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

        <!-- ======================================================== buttons -->

        <!--
            FlatButton is the whole button chrome, templated rather than restyled: Fluent paints its own
            pointer-over and pressed faces from theme brushes, so setting Background alone would show a
            blue-grey flash the palette never chose.

            The disabled face is WindowBrush rather than a dimmed ButtonFaceBrush, because the disabled
            state has to read as "not available yet", and a translucent grey button on a grey panel reads
            as a rendering fault instead.
        -->
        <ControlTheme x:Key="FlatButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ButtonFaceBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="face"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#face">
                <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#face">
                <Setter Property="Opacity" Value="0.75" />
            </Style>
            <Style Selector="^:disabled /template/ Border#face">
                <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </ControlTheme>

        <!-- ======================================================== chips -->

        <!--
            A setting's value, as a row of choices.

            A ComboBox would be the obvious control and is deliberately not used: its dropdown is a Popup
            with its own theme and its item container would have to be restyled too. Chips are a few lines,
            look right, and are better anyway for the two or three values these settings usually offer.

            ToggleButton rather than RadioButton because the grouping is done in code against the entry
            being edited, which keeps a setting's chips independent of every other setting's.
        -->
        <ControlTheme x:Key="ChoiceChip" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Border Name="face"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#face">
                <Setter Property="Background" Value="{StaticResource SurfaceShadedBrush}" />
            </Style>
            <Style Selector="^:checked /template/ Border#face">
                <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
        </ControlTheme>

        <!-- ======================================================== tab strip -->

        <!--
            An underline rather than a raised border: it marks the selection without adding chrome, which
            was the whole complaint about the old strip. Templated because Fluent's tab carries its own
            background and an indicator pipe in theme colours.
        -->
        <ControlTheme x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border Name="face" Background="Transparent" Padding="18,0" MinHeight="38">
                            <ContentPresenter Content="{TemplateBinding Header}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Border Name="mark" Height="2" VerticalAlignment="Bottom"
                                Background="{StaticResource AccentBrush}" IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:selected /template/ Border#mark">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:selected /template/ Border#face">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#face">
                <Setter Property="Background" Value="{StaticResource SurfaceShadedBrush}" />
            </Style>
        </ControlTheme>

    </Styles.Resources>

    <!-- ============================================================ typography -->

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.strong">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Explanatory text. Deliberately smaller and quieter than everything else. -->
    <Style Selector="TextBlock.note">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Header and cell text for the column tables. -->
    <Style Selector="TextBlock.columnHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- No Foreground setter on purpose: a cell takes its colour from the row it is in, which is how a
         disabled mod or a disabled dependency is shown without a second template. -->
    <Style Selector="TextBlock.cell">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============================================================ config editor text -->

    <!-- The name as the mod wrote it, so it is recognisable against the value. -->
    <Style Selector="TextBlock.settingName">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Type and default, the two things that tell you whether an edit will be accepted. -->
    <Style Selector="TextBlock.settingHint">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The mod's own documentation for a setting. -->
    <Style Selector="TextBlock.settingDoc">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="TextBlock.sectionHeading">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <!-- ============================================================ rules and cards -->

    <!-- The rule under the column names, so the header reads as a header without a raised panel. -->
    <Style Selector="Border.rule">
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- One setting: its documentation above it, its name and value below. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ============================================================ input -->

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ============================================================ list -->

    <!--
        The rows are drawn by an ItemTemplate holding a Grid, not by a column-header control, because
        the last thing a table like this needs is a column that takes up whatever width is left over -
        and no stock header supports that at all.
    -->
    <Style Selector="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Fluent draws pointer-over and selection in its own brushes on the item's content presenter.
         Setting them here keeps the same grey-on-grey the rest of the window is made of. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceShadedBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
    </Style>

</Styles>

<Window x:Class="Switchboard.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Switchboard.Views"
        Title="Scam With Your Friends"
        Icon="avares://Switchboard/assets/switchboard.png"
        Width="1060" Height="720" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowGlowBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        Foreground="{StaticResource TextBrush}">

    <!--
        Four tabs and a status line. A switchboard earns its place by making four things easy: fix a broken
        install, see what is installed, install something new, and read what the game said. Anything else
        belongs in a mod.

        All four pages are created up front and kept alive. Avalonia, like WPF before it, would happily
        discard a page's visual tree and rebuild it whenever its tab was reselected, which would silently
        throw away scroll position and any half-typed URL on the Get mods tab.

        The two style layers are set up in App.xaml: FluentTheme underneath and the switchboard's own
        palette on top. StaticResource here reaches both, which is what makes the window look like the
        rest of the tool.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- A newer switchboard release on GitHub. Hidden until a check finds one: most launches
             are already current, and a permanent strip would train everyone to ignore it.

             The site's status strip: a panel on the ground with a gold rule under it. -->
        <Border x:Name="UpdateBar" Grid.Row="0"
                IsVisible="False"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,0,0,2"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateText"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="UpdateHint"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <!--
                    The release is one executable, so there is nothing to unpack and the app can
                    replace itself. This is the button that does it; the release page is still
                    there for anyone who would rather see what they are getting first.
                -->
                <Button x:Name="UpdateNowButton"
                        Grid.Column="1"
                        Content="Update now"
                        Margin="12,0,0,0"
                        MinWidth="110"
                        VerticalAlignment="Center"
                        Theme="{StaticResource AccentButton}"
                        Click="OnUpdateNow" />

                <Button x:Name="ViewReleaseButton"
                        Grid.Column="2"
                        Content="Release page"
                        Margin="8,0,0,0"
                        MinWidth="110"
                        VerticalAlignment="Center"
                        Theme="{StaticResource FlatButton}"
                        Click="OnViewRelease" />

                <Button Grid.Column="3"
                        Content="Dismiss"
                        Margin="8,0,0,0"
                        MinWidth="80"
                        VerticalAlignment="Center"
                        Theme="{StaticResource FlatButton}"
                        Click="OnDismissUpdate" />
            </Grid>
        </Border>

        <!--
            The tab strip. The line under it that says what the tab is for belongs to each view,
            so it sits with the content it describes rather than above the navigation.
        -->
        <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged" Padding="0">
            <TabItem Header="Setup" Theme="{StaticResource TabHeader}">
                <views:SetupView x:Name="SetupPage" />
            </TabItem>
            <TabItem Header="Mods" Theme="{StaticResource TabHeader}">
                <views:ModsView x:Name="ModsPage" />
            </TabItem>
            <TabItem Header="Get mods" Theme="{StaticResource TabHeader}">
                <views:GetModsView x:Name="GetModsPage" />
            </TabItem>
            <TabItem Header="Log" Theme="{StaticResource TabHeader}">
                <views:LogView x:Name="LogPage" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Ready." />

                <!--
                    A quiet action next to the loud one. Checking for an update is something a
                    person does when they want to know, not something they do to use the tool, so
                    it is a link-coloured button rather than a second button that competes with
                    the one that starts the game.
                -->
                <Button x:Name="CheckUpdatesButton"
                        Grid.Column="1"
                        Content="Check for updates"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Theme="{StaticResource GhostButton}"
                        Click="OnCheckUpdates" />

                <!--
                    Playing the game is the point of the whole tool, so it is the one gold button
                    in the window and it is named for what it does rather than for what it is.
                -->
                <Button Grid.Column="2"
                        Content="Play game"
                        MinWidth="130"
                        Height="34"
                        VerticalAlignment="Center"
                        Theme="{StaticResource AccentButton}"
                        Click="OnPlay" />
            </Grid>
        </Border>
    </Grid>
</Window>

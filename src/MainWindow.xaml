<Window x:Class="ScamWYF.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ScamWYF.Launcher.Views"
        Title="Scam With Your Friends"
        Width="1060" Height="720" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource TextBrush}">

    <!--
        Four tabs and a status line. A launcher earns its place by making four things easy: fix a broken
        install, see what is installed, install something new, and read what the game said. Anything else
        belongs in a mod.

        All four pages are created up front and kept alive. WPF would happily discard a page's visual tree
        and rebuild it whenever its tab was reselected, which would silently throw away scroll position and
        any half-typed URL on the Get mods tab.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" SelectionChanged="OnTabChanged" Padding="0">
            <TabItem Header="Setup">
                <views:SetupView x:Name="SetupPage" />
            </TabItem>
            <TabItem Header="Mods">
                <views:ModsView x:Name="ModsPage" />
            </TabItem>
            <TabItem Header="Get mods">
                <views:GetModsView x:Name="GetModsPage" />
            </TabItem>
            <TabItem Header="Log">
                <views:LogView x:Name="LogPage" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Ready." />

                <Button Grid.Column="1"
                        Content="Play"
                        MinWidth="100"
                        Style="{StaticResource AccentButton}"
                        Click="OnPlay" />
            </Grid>
        </Border>
    </Grid>
</Window>
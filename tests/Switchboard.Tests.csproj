<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The switchboard's tests.

    These compile the app's own sources rather than a reference to the built switchboard, which is the same
    choice the hand-rolled csc runner made and for the same reason: the tests exist to exercise GameInstall,
    PluginScanner, ModManager, Http, ModCatalogue and ModInstaller, and compiling those files directly
    means there is no second copy of the logic to drift out of step with the first.

    Consequence worth stating: the UI is not under test, because the UI is presentation and these tests are
    about what happens to files on disk. What that leaves uncovered is listed in README.md under Testing.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 to match the switchboard and the Setup core it references. The project used to be net48
         because there was no reason to be anything else; the switchboard moved, so this follows. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Switchboard.Tests</AssemblyName>
    <RootNamespace>Switchboard.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <!-- The default run is offline; -Online swaps which of the two programs is compiled. Both define a
         Main, and an assembly may only have one, so the switch has to be a compile-time choice rather than
         a runtime argument. tools/test-getmods.ps1 and tools/test-getmods.sh pass it. -->
    <Online Condition="'$(Online)' == ''">false</Online>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI-free half of the switchboard, named explicitly. Everything excluded here is a view, a dialog,
         or something else that needs Avalonia. Program.cs and Palette.cs are the Avalonia entry point and
         its resource lookups, so they are excluded for the same reason. -->
    <Compile Include="../src/**/*.cs"
             Exclude="../src/App.xaml.cs;../src/Dialogs.cs;../src/MainWindow.xaml.cs;../src/Program.cs;../src/Palette.cs;../src/views/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The setup logic, compiled from the same source the switchboard links. It also brings Mono.Cecil in as
         a transitive package, which is what PluginScanner reads plugin metadata with. -->
    <ProjectReference Include="../../Setup/src/ScamWYF.Setup.Core/ScamWYF.Setup.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Online)' != 'true'">
    <Compile Remove="OnlineModTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Online)' == 'true'">
    <Compile Remove="GetModsTests.cs" />
  </ItemGroup>

</Project>
